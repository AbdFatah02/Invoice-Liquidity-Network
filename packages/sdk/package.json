{
  "name": "@iln/sdk-next",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "require": "./dist/events.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./xdr": {
      "types": "./dist/xdr.d.ts",
      "import": "./dist/xdr.js",
      "require": "./dist/xdr.cjs"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "require": "./dist/schemas/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/browser/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/tokens.ts src/events.ts src/errors.ts src/xdr.ts src/schemas/index.ts --format cjs,esm --dts --clean",
    "build:browser": "vite build --config vite.browser.config.ts",
    "test": "jest",
    "test:mutation": "stryker run stryker.config.mjs",
    "test:browser": "playwright test tests/browser/",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "docs:preview": "pnpm docs:generate && pnpm --filter @iln/docs dev"
  },
  "dependencies": {
    "@iln/shared": "workspace:*",
    "@stellar/stellar-sdk": "^15.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/jest-runner": "^8.6.0",
    "fast-check": "^3.23.0",
    "@types/jest": "^30.0.0",
    "@types/semver": "^7.5.0",
    "jest": "^30.4.2",
    "semver": "^7.6.0",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.0",
    "tsx": "^4.15.0",
    "typedoc": "^0.27.0",
    "typedoc-plugin-markdown": "^4.0",
    "typescript": "^5.0.0",
    "vite": "^6.1.0",
    "vite-plugin-wasm": "^3.4.1"
  }
}
