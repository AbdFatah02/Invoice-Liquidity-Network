    "documentedIn": "docs/sdk-versioning.md",
    "runbook": "docs/runbooks/sdk-support-windows.md",
    "currentStable": "@iln/sdk",
    "supportModel": "current minor plus the previous minor",
    "releaseCadence": "on-demand",
    "deprecationNoticeDays": 90,
    "minimumSupportedNode": ">=20"
  },
