{
  "name": "invoice-liquidity-network",
  "private": true,
  "scripts": {
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "vitest run tests/e2e/*.test.ts",
    "test:checklist": "node --test scripts/__tests__/mainnet-checklist-parser.test.js",
    "test:provenance": "node --test scripts/__tests__/release-provenance.test.js",
    "test:compatibility": "vitest run scripts/__tests__/check-compatibility.test.ts",
    "test:audit": "node --test scripts/__tests__/dependency-audit.test.js",
    "test:load": "ts-node --esm scripts/load-test.ts",
    "test:load:indexer": "ts-node --esm scripts/load-test-indexer.ts",
    "test:load:notifications": "ts-node --esm scripts/load-test-notifications.ts",
    "test:load:oracle": "ts-node --esm scripts/load-test-oracle.ts",
    "build": "turbo run build",
    "changeset:version": "changeset version",
    "licence:check": "node scripts/check-licenses.js",
    "generate:types": "ts-node --esm scripts/generate-types.ts",
    "generate:shared-types": "node --import tsx/esm scripts/generate-shared-types.mts --spec backend/target/spec.json --out packages/shared/src/types.ts",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo run type-check",
    "docs:dev": "npm run dev -w @invoice-liquidity/docs",
    "docs:build": "npm run docs:generate -w @iln/sdk && npm run docs:generate -w @invoice-liquidity/cli && npm run build -w @invoice-liquidity/docs",
    "docs:api": "npm run docs:generate -w @iln/sdk",
    "docs:cli": "npm run docs:generate -w @invoice-liquidity/cli",
    "react:dev": "npm run dev -w @iln/react",
    "react:build": "npm run build -w @iln/react",
    "react:test": "npm run test -w @iln/react",
    "oracle:dev": "npm run dev -w @iln/oracle-service",
    "oracle:build": "npm run build -w @iln/oracle-service",
    "oracle:test": "npm run test -w @iln/oracle-service",
    "dead-code:check": "knip",
    "gitleaks:scan": "pnpm exec gitleaks detect --no-git -s . --config gitleaks.toml --baseline-path .secrets.baseline",
    "gitleaks:baseline": "pnpm exec gitleaks detect --no-git -s . --config gitleaks.toml --report-format json --report-path .secrets.baseline",
    "security:audit": "node scripts/dependency-audit.js audit",
    "security:audit:fix": "node scripts/dependency-audit.js audit --fix",
    "security:snyk": "node scripts/dependency-audit.js snyk",
    "security:licenses": "node scripts/dependency-audit.js licenses",
    "security:scan": "node scripts/dependency-audit.js scan",
    "security:report": "node scripts/dependency-audit.js report",
    "syncpack:check": "syncpack list-mismatches",
    "validate:packages": "node scripts/validate-packages.mjs",
    "check-monorepo-map": "node scripts/check-monorepo-map.mjs",
    "validate:monorepo-map": "node scripts/check-monorepo-map.mjs",
    "check-compatibility": "node --loader ts-node/esm scripts/check-compatibility.ts",
    "check:compatibility": "node --loader ts-node/esm scripts/check-compatibility.ts",
    "validate:lockfiles": "node scripts/check-no-foreign-lockfiles.mjs",
    "enforce:postmortem-sla": "node scripts/enforce-postmortem-sla.mjs",
    "test:postmortem-sla": "node --test scripts/__tests__/enforce-postmortem-sla.test.js",
    "validate:meta-nav": "node scripts/check-meta-nav.mjs",
    "validate:commit-convention": "node scripts/check-commit-convention.mjs",
    "check:shared-types": "node scripts/check-no-duplicate-types.mjs",
    "drift:check": "node scripts/check-monorepo-map-drift.mjs",
    "test:drift": "node --test scripts/__tests__/check-monorepo-map-drift.test.mjs",
    "check:sdk-fixture-mocks": "node scripts/check-sdk-fixture-mocks.mjs",
    "test:sdk-fixture-mocks": "node --test scripts/__tests__/check-sdk-fixture-mocks.test.mjs",
    "check:contract-abi-compat": "node scripts/check-contract-abi-compatibility.mjs",
    "test:contract-abi-compat": "node --test scripts/__tests__/check-contract-abi-compatibility.test.mjs",
    "release:verify-dry-run": "node scripts/verify-release-dry-run.mjs",
    "audit:packages": "node scripts/audit-package-releases.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "release:audit-log": "node scripts/release-audit-log.mjs",
    "test:release-scripts": "node --test scripts/__tests__/verify-release-dry-run.test.mjs scripts/__tests__/release-audit-log.test.mjs",
    "canary:rollout": "node scripts/canary/rollout.mjs",
    "canary:drill": "node scripts/canary/rollout-drill.mjs",
    "test:canary": "node --test scripts/__tests__/canary-rollout-decision.test.mjs scripts/__tests__/canary-prometheus-adapter.test.mjs scripts/__tests__/canary-rollout.test.mjs scripts/__tests__/canary-register-target.test.mjs",
    "alert-runbook:check": "node scripts/check-alert-runbook-links.mjs",
    "test:alert-runbook": "node --test scripts/__tests__/check-alert-runbook-links.test.mjs",
    "test:runtime-budgets": "node scripts/check-test-runtime-budgets.mjs",
    "test:test-runtime-budgets": "node --test scripts/__tests__/check-test-runtime-budgets.test.mjs",
    "sdk:compat-matrix": "node scripts/check-sdk-compat-matrix.mjs",
    "test:sdk-compat-versions": "node --test scripts/__tests__/sdk-compat-versions.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@iln/sdk": "workspace:*",
    "@commitlint/cli": "^17.6.0",
    "@commitlint/config-conventional": "^17.6.0",
    "@stellar/stellar-sdk": "^15.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^8.0.0",
    "jsdom": "^29.1.1",
    "knip": "^6.15.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^2.8.8",
    "syncpack": "^13.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.15.0",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "prepare": "husky install || true",
  "bin": {
    "iln-dev": "packages/scripts/bin/iln.js"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "axios": ">=1.16.0"
    }
  }
}
