{
  "ignore": [
    // Branch-local indexer DLQ module, wired in incrementally.
    "indexer/src/dlq.ts",
    "frontend/**",
    "backend/**",
    "oracle-service/**",
    "notifications/src/audit-cli.ts",
    "packages/sdk/src/schemas/**",
    "tests/sdk-integration/compat-matrix/fixtures/**"
  ],
  "ignoreBinaries": [
    "playwright",
    "sqlite3",
    "sha256sum",
    "gsutil",
    "gitleaks",
    // Stellar CLI, invoked by scripts/provision-e2e-contract.mjs to deploy the
    // real E2E contract (#1241). Installed via `cargo install stellar-cli` in CI.
    "stellar"
  ],
  "rules": {
    "optionalPeerDependencies": "off",
    "duplicates": "off"
  },
  "ignoreIssues": {
    // Governance error surfacing (issue #971): kept exported for CLI/reporting
    // consumers even though it is not imported in-tree yet.
    "cli/src/errors.ts": ["exports"],
    // Docs search widget is loaded dynamically by the deployed docs build.
    "packages/docs/components/AlgoliaSearch.tsx": ["exports"],
    "packages/docs/lib/docs-version.ts": ["exports"],
    "sdk/src/logger.ts": ["enumMembers"]
  },
  "workspaces": {
    "sdk": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@commitlint/cli", "@commitlint/config-conventional"],
      "ignoreUnresolved": ["./xdr"]
    },
    ".": {
      "entry": ["scripts/*.ts", "scripts/migrations/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": ["husky"]
    },
    "packages/sdk": {
      "entry": [
        "src/index.ts",
        "src/tokens.ts",
        "src/events.ts",
        "src/errors.ts",
        "src/xdr.ts",
        "src/**/*.test.ts",
        "src/crypto-browser.ts"
      ],
      "project": ["src/**/*.ts", "*.ts"],
      "ignoreDependencies": ["@stellar/freighter-api"]
    },
    "cli": {
      "entry": ["src/bin.ts", "src/cli.ts", "src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@commitlint/cli", "@commitlint/config-conventional"]
    },
    "indexer": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@commitlint/cli", "@commitlint/config-conventional"]
    },
    "notifications": {
      "entry": ["src/service.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@commitlint/cli", "@commitlint/config-conventional"]
    },
    "docs": {
      "entry": ["pages/**/*.{ts,tsx,mdx}", "theme.config.jsx", "next.config.{js,mjs}"],
      "project": ["**/*.{ts,tsx,jsx}"]
    },
    "packages/indexer": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@commitlint/cli", "@commitlint/config-conventional"]
    },
    "packages/opentelemetry": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@iln/sdk"]
    },
    "packages/docs": {
      "entry": ["mdx-components.ts", "app/**/*.{ts,tsx}", "content/**/_meta.ts"],
      "project": ["**/*.{ts,tsx}"],
      "ignoreUnresolved": [],
      "ignoreDependencies": [
        "@iln/eslint-config",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "eslint-config-prettier",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "tailwindcss",
        "@docsearch/react"
      ]
    },
    "packages/scripts": {
      "entry": ["**/*.{ts,js}"],
      "project": ["**/*.{ts,js}"]
    },
    "packages/react": {
      "ignoreDependencies": ["@iln/shared"]
    },
    "packages/eslint-config": {
      "ignoreDependencies": []
    }
  },
  "ignoreExportsUsedInFile": true
}
